{
  "name": "ecomgithub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:unit:watch": "vitest --config vitest.unit.config.mts --watch",
    "test:unit:coverage": "vitest --config vitest.unit.config.mts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:watch": "vitest --config vitest.integration.config.mts --watch",
    "test:integration:coverage": "vitest --config vitest.integration.config.mts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^0.535.0",
    "next": "^16.2.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.61.1",
    "react-phone-number-input": "^3.4.17",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "stripe": "^22.6.0",
    "typecheck": "^0.1.2",
    "uuid": "^14.0.1",
    "zod": "^4.0.14",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
